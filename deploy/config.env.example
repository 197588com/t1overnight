# t1overnight 生产配置模板 —— 复制为 deploy/config.env 后按本机情况修改
#
#   cp deploy/config.env.example deploy/config.env && $EDITOR deploy/config.env
#
# 约定：
#   * 只允许 KEY=VALUE，POSIX sh 可直接 `.` 加载。
#   * 带空格的值必须加双引号。
#   * config.env 已被 .gitignore 排除，本文件只是模板，不要往里填真实凭证。

# --------------------------------------------------------------------------- #
# 1. 路径
# --------------------------------------------------------------------------- #

# 项目根。调用方（run_daily.sh / status.sh）会先用脚本自身位置推导并 export，
# 这里的值只在被单独 source 时兜底 —— 一般无需修改。
T1_ROOT="${T1_ROOT:-$HOME/t1overnight}"

# 解释器绝对路径。launchd 不解析 PATH，必须是绝对路径。
T1_PY="${T1_PY:-$(command -v python3)}"

# 日 K 数据池（parquet 目录），需含 daily_k.parquet / universe.parquet。
T1_DATAPOOL="${T1_DATAPOOL:-$HOME/datapool/parquet}"

# 可交易标的清单。留空则推导为 $T1_DATAPOOL/universe.parquet。
# 必须推导成非空值：daily_signal.py 用 os.environ.get 取值，导出空串会让默认值失效。
T1_UNIVERSE="${T1_UNIVERSE:-}"

# 产物与状态目录（相对项目根）
T1_DATASET="${T1_DATASET:-outputs/t1_dataset.parquet}"
T1_APPEND_DIR="${T1_APPEND_DIR:-outputs/append}"
T1_OUT_DIR="${T1_OUT_DIR:-outputs/live}"
T1_MODELS="${T1_MODELS:-models/walkforward_v4}"

# --------------------------------------------------------------------------- #
# 2. 账户权限（决定能买哪些板）
# --------------------------------------------------------------------------- #
# 0 沪主板 1 深主板 2 创业板 3 科创板 4 北交所
# 默认 0,1,2 = 主板无门槛 + 创业板（需 10 万资产 + 24 个月交易经验）。
# 科创板（688）需 50 万 + 24 个月，默认不开通。
T1_BOARDS="${T1_BOARDS:-0,1,2}"
T1_TIER="${T1_TIER:-主板+创业板}"

# --------------------------------------------------------------------------- #
# 3. 执行口径
# --------------------------------------------------------------------------- #
# 开盘跳空上限。开盘涨幅超过该值当日放弃（不顺延次选）。
# 改这个值等于改策略，必须有回测对照。
T1_GAP_MAX="${T1_GAP_MAX:-0.015}"

# 候选榜单长度。生产只取第 1 名执行，其余为观察位。
T1_TOP="${T1_TOP:-5}"

# --------------------------------------------------------------------------- #
# 4. 调度时间（本地时区）
# --------------------------------------------------------------------------- #
T1_EVENING_AT="${T1_EVENING_AT:-17:20}"
T1_EVENING_DEADLINE="${T1_EVENING_DEADLINE:-21:00}"
T1_MORNING_AT="${T1_MORNING_AT:-07:50}"
T1_MORNING_DEADLINE="${T1_MORNING_DEADLINE:-08:40}"

# launchd 备用层相对主调度的错峰分钟数（flock 保证只有一个真正执行）
T1_LAUNCHD_OFFSET_MIN="${T1_LAUNCHD_OFFSET_MIN:-4}"

# --------------------------------------------------------------------------- #
# 4b. 单票仓位（风控红线，非 alpha 参数）
# --------------------------------------------------------------------------- #
T1_POSITION_PCT="${T1_POSITION_PCT:-0.40}"

# --------------------------------------------------------------------------- #
# 5. 前向验证门槛
# --------------------------------------------------------------------------- #
# 影子盘累计 ≥ N 个交易日且毛均 ≥ X bp，才允许放大到实盘口径。
T1_GATE_DAYS="${T1_GATE_DAYS:-60}"
T1_GATE_BP="${T1_GATE_BP:-25}"

# 账户本金（元），用于算仓位占比与手数。
T1_CAPITAL="${T1_CAPITAL:-100000}"

# --------------------------------------------------------------------------- #
# 6. 日志保留
# --------------------------------------------------------------------------- #
T1_LOG_RETAIN_DAYS="${T1_LOG_RETAIN_DAYS:-90}"

# --------------------------------------------------------------------------- #
# 7. 失败告警（仅 launchd 备用层）
# --------------------------------------------------------------------------- #
# 1 = 开启；0 = 关闭。走 macOS 原生通知（osascript），无额外依赖。
T1_ALERT="${T1_ALERT:-0}"

# --------------------------------------------------------------------------- #
# 8. 企业微信推送（可选，默认关闭）
# --------------------------------------------------------------------------- #
# 置 1 前需要本机装好 wecom-cli 并完成授权；未装时保持 0。
T1_WECOM_PUSH="${T1_WECOM_PUSH:-0}"

# 推送目标 chat_id。留空 = 授权人本人（由 wecom-cli identity whoami 解析）。
# 填值时必须是 wecom-cli 认的会话标识，不能填名字。
T1_WECOM_TARGET="${T1_WECOM_TARGET:-}"

# wecom-cli 登录态目录（宿主会以 WECOM_CLI_CONFIG_DIR 注入；launchd 需显式指定）。
T1_WECOM_CONFIG_DIR="${T1_WECOM_CONFIG_DIR:-}"

# 空值兜底：见 T1_UNIVERSE 的注释，必须在 export 前补成非空
if [ -z "${T1_UNIVERSE}" ]; then
  T1_UNIVERSE="${T1_DATAPOOL}/universe.parquet"
fi

# 导出给子进程（python 侧通过 os.environ 读取）
export T1_ROOT T1_PY T1_DATAPOOL T1_UNIVERSE
export T1_DATASET T1_APPEND_DIR T1_OUT_DIR T1_MODELS
export T1_BOARDS T1_TIER T1_GAP_MAX T1_TOP T1_POSITION_PCT
export T1_EVENING_AT T1_EVENING_DEADLINE T1_MORNING_AT T1_MORNING_DEADLINE
export T1_LAUNCHD_OFFSET_MIN T1_GATE_DAYS T1_GATE_BP T1_LOG_RETAIN_DAYS T1_CAPITAL
export T1_ALERT T1_WECOM_PUSH T1_WECOM_TARGET T1_WECOM_CONFIG_DIR
